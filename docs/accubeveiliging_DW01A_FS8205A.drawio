<mxfile host="app.diagrams.net"><diagram id="dw01a" name="DW01A + FS8205A"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Accubeveiliging: DW01A + FS8205A&lt;/b&gt;&lt;br&gt;De DW01A is de &lt;b&gt;bewaker&lt;/b&gt; die meet; de FS8205A bevat twee &lt;b&gt;schakelaars&lt;/b&gt; (MOSFET's) in de min-leiding van de cel." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;18650 cel&lt;/b&gt;&lt;br&gt;(BT1)&lt;br&gt;&lt;br&gt;+ boven&lt;br&gt;&amp;minus; onder" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="130" height="230" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;BAT+&lt;/b&gt;&lt;br&gt;naar lader (TP4056) en systeem (VSYS)&lt;br&gt;&lt;i&gt;via Q3 ompoolbeveiliging&lt;/i&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="270" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;DW01A&lt;/b&gt;&lt;br&gt;de bewaker&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;meet celspanning (VCC&amp;minus;VSS)&lt;br&gt;en stroom (via CS)&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="210" width="210" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;R6 100&amp;Omega; + C4 100nF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;filter: schone voeding&lt;br&gt;voor de DW01A&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="180" width="150" height="60" as="geometry"/></mxCell><mxCell id="c16" value="B&amp;minus;" style="html=1;whiteSpace=wrap;ellipse;fillColor=#333333;fontColor=#ffffff;fontSize=12;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="215" y="445" width="50" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;FET1 = ONTLAAD-schakelaar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FS8205A pin 2/3 (S1), 4 (G1)&lt;br&gt;body-diode laat alleen &lt;b&gt;laad&lt;/b&gt;stroom door &amp;rarr;&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="310" y="420" width="220" height="100" as="geometry"/></mxCell><mxCell id="c18" value="D" style="html=1;whiteSpace=wrap;ellipse;fillColor=#333333;fontColor=#ffffff;fontSize=12;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="565" y="450" width="40" height="40" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;FET2 = LAAD-schakelaar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FS8205A pin 6/7 (S2), 5 (G2)&lt;br&gt;&amp;larr; body-diode laat alleen &lt;b&gt;ontlaad&lt;/b&gt;stroom door&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="220" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;P&amp;minus; = GND&lt;/b&gt;&lt;br&gt;systeemmassa&lt;br&gt;(lader en ESP32)" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="210" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;R7 1k&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeWidth=2;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="80" height="36" as="geometry"/></mxCell><mxCell id="c22" value="cel + = BAT+" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="150"/></Array></mxGeometry></mxCell><mxCell id="c23" value="cel &amp;minus;" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="470"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="BAT+" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="VCC (pin 5)" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#9673a6;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#5b2c6f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="c15" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="VSS (pin 6) = B&amp;minus;" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#9673a6;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#5b2c6f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.75;" edge="1" parent="1" source="c16" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="292"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#9673a6;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#5b2c6f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="318"/></Array></mxGeometry></mxCell><mxCell id="c32" value="CS (pin 2): spanning over&lt;br&gt;beide FET's = stroom &amp;times; ~50 m&amp;Omega;" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#9673a6;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#5b2c6f;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="c21" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="OD (pin 1)" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#6c8ebf;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#1f4e79;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="OC (pin 3)" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#6c8ebf;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontColor=#1f4e79;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="557" y="380"/><mxPoint x="750" y="380"/></Array></mxGeometry></mxCell><mxCell id="c37" value="LAADSTROOM  GND &amp;rarr; FET2 &amp;rarr; FET1 &amp;rarr; cel&amp;minus;" style="endArrow=block;endFill=1;html=1;strokeWidth=4;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="560" as="sourcePoint"/><mxPoint x="270" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="ONTLAADSTROOM  cel&amp;minus; &amp;rarr; FET1 &amp;rarr; FET2 &amp;rarr; GND" style="endArrow=block;endFill=1;html=1;strokeWidth=4;strokeColor=#d79b00;fontColor=#b36b00;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="600" as="sourcePoint"/><mxPoint x="880" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Waarom twee FET's rug-aan-rug?&lt;/b&gt;&lt;br&gt;Een MOSFET heeft een ingebouwde &lt;i&gt;body-diode&lt;/i&gt; en kan daardoor maar in één richting blokkeren. Door twee FET's met de drains tegen elkaar (D) te zetten kan de DW01A &lt;b&gt;laden&lt;/b&gt; en &lt;b&gt;ontladen&lt;/b&gt; los van elkaar blokkeren. Is één FET uit, dan kan de stroom in de andere richting nog via de body-diode: zo kun je een lege cel altijd weer laden." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="520" height="130" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;In dit ontwerp&lt;/b&gt;&lt;br&gt;De TP4056 stopt al netjes op 4,2 V en het systeem trekt &amp;lt; 0,5 A. De DW01A is dus het &lt;b&gt;vangnet&lt;/b&gt;: hij grijpt alleen in als er iets misgaat (lader defect, kortsluiting, accu leeg getrokken tijdens een lange stroomstoring)." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#eef5ff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="520" height="130" as="geometry"/></mxCell><mxCell id="c41" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;Situatie&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;DW01A ziet&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;OD &amp;rarr; FET1 (ontladen)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;OC &amp;rarr; FET2 (laden)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;Gevolg&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#e1d5e7&quot;&gt;Herstelt als&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;Normaal&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;2,4 &amp;ndash; 4,3 V, stroom &amp;lt; ~3 A&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;hoog &amp;rarr; AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;hoog &amp;rarr; AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;laden en ontladen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;&amp;ndash;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;Overladen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;cel &amp;gt; ~4,3 V&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;laag &amp;rarr; UIT&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;laden stopt; ontladen kan nog (body-diode FET2)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;cel zakt onder ~4,1 V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;Te diep ontladen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;cel &amp;lt; ~2,4 V&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;laag &amp;rarr; UIT&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;ontladen stopt (systeem valt uit); laden kan nog (body-diode FET1)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;lader aansluiten, cel &amp;gt; ~3,0 V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;Overstroom&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;CS &amp;gt; 0,15 V (&amp;asymp; 3 A)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;laag &amp;rarr; UIT&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;ontladen stopt&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;belasting weg&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;Kortsluiting&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;CS &amp;gt; ~1,35 V&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;direct UIT&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;AAN&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;binnen microseconden af&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px&quot;&gt;belasting weg&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1070" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>